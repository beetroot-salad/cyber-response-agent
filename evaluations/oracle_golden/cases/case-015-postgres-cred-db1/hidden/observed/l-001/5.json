{"query": "FROM logs-postgresql.log-*\n| WHERE host.name == \"db-1\" AND @timestamp >= \"2026-07-27T20:00:00Z\" AND @timestamp < \"2026-07-28T00:00:00Z\"\n| EVAL msg_prefix = SUBSTRING(message, 0, 40)\n| STATS count = COUNT(*) BY msg_prefix\n| SORT count DESC\n| LIMIT 20", "columns": [{"name": "count", "type": "long"}, {"name": "msg_prefix", "type": "keyword"}], "row_count": 9, "values": [[936, "password authentication failed for user "], [861, "Role \"root\" does not exist.\n\tConnection "], [16, "Role \"backup\" does not exist.\n\tConnectio"], [16, "Role \"dbadmin\" does not exist.\n\tConnecti"], [10, "Role \"pgadmin\" does not exist.\n\tConnecti"], [10, "Role \"reporting\" does not exist.\n\tConnec"], [10, "Role \"superuser\" does not exist.\n\tConnec"], [6, "User \"postgres\" has no password assigned"], [6, "Role \"admin\" does not exist.\n\tConnection"]]}