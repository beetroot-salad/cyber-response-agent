{"query": "FROM logs-system.auth-*\n| WHERE @timestamp >= \"2026-07-26T19:51:42Z\" AND @timestamp < \"2026-07-26T20:21:42Z\"\n        AND host.name == \"web-2\"\n        AND event.outcome IS NOT NULL\n| STATS accepted   = COUNT(*) WHERE event.outcome == \"success\",\n        failed     = COUNT(*) WHERE event.outcome == \"failure\",\n        first_seen = MIN(@timestamp),\n        last_seen  = MAX(@timestamp)\n        BY auth_method = CASE(message LIKE \"*publickey*\", \"publickey\",\n                              message LIKE \"*password*\",  \"password\", \"other\"),\n           source.ip, host.name, user.name\n| SORT accepted DESC, failed DESC", "columns": [{"name": "accepted", "type": "long"}, {"name": "failed", "type": "long"}, {"name": "first_seen", "type": "date"}, {"name": "last_seen", "type": "date"}, {"name": "auth_method", "type": "keyword"}, {"name": "source.ip", "type": "ip"}, {"name": "host.name", "type": "keyword"}, {"name": "user.name", "type": "keyword"}], "row_count": 6, "values": [{"accepted": 4, "failed": 0, "first_seen": "2026-07-26T20:06:04.000Z", "last_seen": "2026-07-26T20:06:40.000Z", "auth_method": "other", "source.ip": null, "host.name": "web-2", "user.name": null}, {"accepted": 0, "failed": 48, "first_seen": "2026-07-26T19:52:23.000Z", "last_seen": "2026-07-26T19:55:21.000Z", "auth_method": "other", "source.ip": "172.18.0.6", "host.name": "web-2", "user.name": "root"}, {"accepted": 0, "failed": 48, "first_seen": "2026-07-26T19:52:25.000Z", "last_seen": "2026-07-26T19:55:23.000Z", "auth_method": "password", "source.ip": "172.18.0.6", "host.name": "web-2", "user.name": "root"}, {"accepted": 0, "failed": 4, "first_seen": "2026-07-26T20:06:04.000Z", "last_seen": "2026-07-26T20:06:40.000Z", "auth_method": "other", "source.ip": "172.18.0.6", "host.name": "web-2", "user.name": null}, {"accepted": 0, "failed": 4, "first_seen": "2026-07-26T20:06:04.000Z", "last_seen": "2026-07-26T20:06:40.000Z", "auth_method": "other", "source.ip": "172.18.0.6", "ho