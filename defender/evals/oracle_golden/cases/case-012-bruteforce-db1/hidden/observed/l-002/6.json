{"query": "FROM logs-system.auth-*\n| WHERE @timestamp >= \"2026-07-27T09:30:00Z\" AND @timestamp < \"2026-07-27T10:00:00Z\"\n        AND (host.name LIKE \"db-*\" OR host.name LIKE \"web-*\" OR host.name LIKE \"jump-box-*\")\n        AND event.outcome IS NOT NULL\n| STATS accepted = COUNT(*) WHERE event.outcome == \"success\",\n        failed   = COUNT(*) WHERE event.outcome == \"failure\",\n        first_seen = MIN(@timestamp),\n        last_seen  = MAX(@timestamp)\n        BY host.name, source.ip, user.name\n| SORT failed DESC, accepted DESC", "columns": [{"name": "accepted", "type": "long"}, {"name": "failed", "type": "long"}, {"name": "first_seen", "type": "date"}, {"name": "last_seen", "type": "date"}, {"name": "host.name", "type": "keyword"}, {"name": "source.ip", "type": "ip"}, {"name": "user.name", "type": "keyword"}], "row_count": 13, "values": [{"accepted": 0, "failed": 96, "first_seen": "2026-07-27T09:56:07.000Z", "last_seen": "2026-07-27T09:59:12.000Z", "host.name": "db-1", "source.ip": "172.18.0.16", "user.name": "root"}, {"accepted": 6, "failed": 0, "first_seen": "2026-07-27T09:44:52.000Z", "last_seen": "2026-07-27T09:44:52.000Z", "host.name": "web-2", "source.ip": null, "user.name": null}, {"accepted": 6, "failed": 0, "first_seen": "2026-07-27T09:44:52.000Z", "last_seen": "2026-07-27T09:44:52.000Z", "host.name": "web-1", "source.ip": null, "user.name": null}, {"accepted": 3, "failed": 0, "first_seen": "2026-07-27T09:33:33.000Z", "last_seen": "2026-07-27T09:48:56.000Z", "host.name": "web-1", "source.ip": "172.18.0.24", "user.name": "svc.config-mgmt"}, {"accepted": 3, "failed": 0, "first_seen": "2026-07-27T09:33:34.000Z", "last_seen": "2026-07-27T09:48:57.000Z", "host.name": "db-1", "source.ip": "172.18.0.24", "user.name": "svc.config-mgmt"}, {"accepted": 3, "failed": 0, "first_seen": "2026-07-27T09:33:34.775Z", "last_seen": "2026-07-27T09:48:57.653Z", "host.name": "jump-box-1", "source.ip": "172.18.0.24", "user.name": "svc.config-mgmt"}, {"accepted": 3