{"query": "FROM logs-system.auth-*\n| WHERE @timestamp >= \"2026-07-27T09:30:00Z\" AND @timestamp < \"2026-07-27T10:00:00Z\"\n        AND (host.name LIKE \"db-*\" OR host.name LIKE \"web-*\" OR host.name LIKE \"jump-box-*\")\n        AND event.outcome IS NOT NULL\n| STATS accepted   = COUNT(*) WHERE event.outcome == \"success\",\n        failed     = COUNT(*) WHERE event.outcome == \"failure\",\n        first_seen = MIN(@timestamp),\n        last_seen  = MAX(@timestamp)\n        BY auth_method = CASE(message LIKE \"*publickey*\", \"publickey\",\n                              message LIKE \"*password*\",  \"password\", \"other\"),\n           source.ip, host.name, user.name\n| SORT first_seen", "columns": [{"name": "accepted", "type": "long"}, {"name": "failed", "type": "long"}, {"name": "first_seen", "type": "date"}, {"name": "last_seen", "type": "date"}, {"name": "auth_method", "type": "keyword"}, {"name": "source.ip", "type": "ip"}, {"name": "host.name", "type": "keyword"}, {"name": "user.name", "type": "keyword"}], "row_count": 16, "values": [{"accepted": 1, "failed": 0, "first_seen": "2026-07-27T09:30:26.000Z", "last_seen": "2026-07-27T09:30:26.000Z", "auth_method": "password", "source.ip": "172.18.0.21", "host.name": "db-1", "user.name": "sre.alice"}, {"accepted": 3, "failed": 0, "first_seen": "2026-07-27T09:33:33.000Z", "last_seen": "2026-07-27T09:48:56.000Z", "auth_method": "password", "source.ip": "172.18.0.24", "host.name": "web-1", "user.name": "svc.config-mgmt"}, {"accepted": 3, "failed": 0, "first_seen": "2026-07-27T09:33:34.000Z", "last_seen": "2026-07-27T09:48:57.000Z", "auth_method": "password", "source.ip": "172.18.0.24", "host.name": "db-1", "user.name": "svc.config-mgmt"}, {"accepted": 3, "failed": 0, "first_seen": "2026-07-27T09:33:34.000Z", "last_seen": "2026-07-27T09:48:57.000Z", "auth_method": "password", "source.ip": "172.18.0.24", "host.name": "web-2", "user.name": "svc.config-mgmt"}, {"accepted": 3, "failed": 0, "first_seen": "2026-07-27T09: