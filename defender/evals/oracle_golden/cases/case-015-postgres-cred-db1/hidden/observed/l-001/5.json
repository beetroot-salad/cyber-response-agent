{"query": "FROM logs-postgresql.log-*\n| WHERE host.name == \"db-1\" AND @timestamp >= \"2026-07-27T20:00:00Z\" AND @timestamp < \"2026-07-28T00:00:00Z\"\n| EVAL msg_prefix = SUBSTRING(message, 0, 40)\n| STATS count = COUNT(*) BY msg_prefix\n| SORT count DESC\n| LIMIT 20", "columns": [{"name": "count", "type": "long"}, {"name": "msg_prefix", "type": "keyword"}], "row_count": 9, "values": [{"count": 936, "msg_prefix": "password authentication failed for user "}, {"count": 861, "msg_prefix": "Role \"root\" does not exist.\n\tConnection "}, {"count": 16, "msg_prefix": "Role \"backup\" does not exist.\n\tConnectio"}, {"count": 16, "msg_prefix": "Role \"dbadmin\" does not exist.\n\tConnecti"}, {"count": 10, "msg_prefix": "Role \"pgadmin\" does not exist.\n\tConnecti"}, {"count": 10, "msg_prefix": "Role \"reporting\" does not exist.\n\tConnec"}, {"count": 10, "msg_prefix": "Role \"superuser\" does not exist.\n\tConnec"}, {"count": 6, "msg_prefix": "User \"postgres\" has no password assigned"}, {"count": 6, "msg_prefix": "Role \"admin\" does not exist.\n\tConnection"}]}