#!/usr/bin/env bash
# Stable invocation shim for the lessons frontmatter CLI: grep over lesson frontmatter only +
# viable-tag enumeration (runtime/lessons_engine/lessons_fm.py). Non-adapter, read-only
# tooling — stays allowed in the main loop (see hooks/_cmd_segments.py NON_ADAPTER_SHIMS). The
# engine finds the lessons dir from the checkout it is imported from, so cwd does not matter.
DEFENDER="${DEFENDER_DIR:-$(cd "$(dirname "$0")/.." && pwd)}"
# M6/O5 (#1092): inside a box the image's OWN python3 carries what this shim needs. A
# command the permission gate admits into the box can never clear DEFENDER_BOX for itself
# (the gate refuses both a leading VAR= and an env/unset wrapper — README.md has the full
# argument), so a gate-admitted call to this shim never falls back to the mounted host venv.
if [ -n "${DEFENDER_BOX:-}" ]; then
    PY=python3
else
    PY="${DEFENDER}/.venv/bin/python3"
    [ -x "$PY" ] || PY=python3
fi
# The engine runs as a module: this checkout's root goes first on PYTHONPATH (a foreign checkout
# named there never answers for this one), and `-P` keeps the working directory — the run
# folder the model writes into — off sys.path. The root is the parent of the tree's REAL
# folder, so a DEFENDER_DIR spelled through a link named otherwise still finds `defender`; a
# DEFENDER_DIR naming no directory is refused, never answered from some other tree.
ROOT="$(cd -P -- "$DEFENDER" 2>/dev/null && cd .. && pwd)" || {
    echo "defender-lessons: DEFENDER_DIR names no directory: $DEFENDER" >&2
    exit 2
}
PYTHONPATH="$ROOT${PYTHONPATH:+:$PYTHONPATH}" \
    exec "$PY" -P -m defender.runtime.lessons_engine.lessons_fm "$@"
