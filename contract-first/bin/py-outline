#!/usr/bin/env python3
"""py-outline — the shape of Python files without their bodies.

Prints each class and function with its line range, signature, and the first line of its
docstring. Use it before reading a test or source file: pick the definitions that matter
from the outline, then read only their line ranges. A whole-file dump stays in an agent's
context for every later step; an outline costs a fraction of it.

Usage:
    py-outline <file-or-dir>... [--tests]

    <file-or-dir>   Python files, or directories searched recursively for *.py
    --tests         only test functions/classes and fixtures (names starting test_/Test,
                    or decorated with a *fixture decorator)
"""
import ast, os, sys


def first_doc_line(node):
    doc = ast.get_docstring(node, clean=True)
    return doc.strip().splitlines()[0] if doc else ""


def is_test(node):
    if node.name.startswith(("test_", "Test")):
        return True
    return any("fixture" in ast.unparse(d) for d in getattr(node, "decorator_list", []))


def signature(node):
    if isinstance(node, ast.ClassDef):
        bases = ", ".join(ast.unparse(b) for b in node.bases)
        return f"class {node.name}({bases})" if bases else f"class {node.name}"
    prefix = "async def" if isinstance(node, ast.AsyncFunctionDef) else "def"
    return f"{prefix} {node.name}({ast.unparse(node.args)})"


def walk(body, depth, tests_only, out):
    for node in body:
        if not isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef, ast.ClassDef)):
            continue
        keep = not tests_only or is_test(node)
        if keep:
            doc = first_doc_line(node)
            line = f"{'  ' * depth}{node.lineno}-{node.end_lineno} {signature(node)}"
            out.append(line + (f"  # {doc}" if doc else ""))
        if isinstance(node, ast.ClassDef) and keep:
            walk(node.body, depth + 1, tests_only, out)


def files(args):
    for a in args:
        if os.path.isdir(a):
            for root, dirs, names in os.walk(a):
                dirs[:] = sorted(d for d in dirs if d not in ("__pycache__", ".venv"))
                yield from (os.path.join(root, n) for n in sorted(names) if n.endswith(".py"))
        else:
            yield a


def main(argv):
    tests_only = "--tests" in argv
    paths = [a for a in argv if a != "--tests"]
    if not paths:
        sys.stderr.write(__doc__)
        return 2
    status = 0
    for path in files(paths):
        try:
            tree = ast.parse(open(path, encoding="utf-8").read(), path)
        except (OSError, SyntaxError) as e:
            sys.stderr.write(f"py-outline: {path}: {e}\n")
            status = 1
            continue
        out = []
        walk(tree.body, 1, tests_only, out)
        print(f"{path} ({len(open(path, encoding='utf-8').readlines())} lines)")
        print("\n".join(out) if out else "  (no definitions)")
    return status


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
