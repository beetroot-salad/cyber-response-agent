#!/bin/sh
# spec-graph — write-tests' two mechanical suite checks, as one bare command.
#
# `$CLAUDE_PLUGIN_ROOT` does NOT expand inside SKILL.md prose and is NOT exported into the Bash
# tool's environment, so a skill that spells a check as `"$CLAUDE_PLUGIN_ROOT"/scripts/...` sends
# the agent hunting for a path it cannot resolve. A plugin's bin/ *is* on the Bash PATH, so the
# skill just says `spec-graph`, and the wrapper finds its own plugin root from $0.
#
# Usage:  spec-graph calls     <suite-dir> [--target <mod> ...]
#         spec-graph nullstub  <suite-dir> [--target <mod> ...] [--python <interp>] [--keep]
#
# Override the interpreter with SPEC_GRAPH_PYTHON=<path>. (nullstub runs pytest with the
# PROJECT's interpreter: --python or $SPEC_GRAPH_TEST_PYTHON.)

set -eu

self=$0
while [ -L "$self" ]; do
  link=$(readlink "$self")
  case $link in
    /*) self=$link ;;
    *) self=$(dirname "$self")/$link ;;
  esac
done
scripts=$(cd "$(dirname "$self")/../scripts" && pwd)

case "${1:-}" in
  calls) script=$scripts/check_calls.py ;;
  nullstub) script=$scripts/check_stub.py ;;
  *)
    echo "usage: spec-graph {calls|nullstub} <suite-dir> ..." >&2
    exit 2
    ;;
esac
shift

exec "${SPEC_GRAPH_PYTHON:-python3}" "$script" "$@"
