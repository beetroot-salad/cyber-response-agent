diff --git a/defender/frontend/src/main.ts b/defender/frontend/src/main.ts
new file mode 100644
index 000000000..3fef3a5ca
--- /dev/null
+++ b/defender/frontend/src/main.ts
@@ -0,0 +1,127 @@
+// The frontend: client-side rendered, built to static files. Three screens (#1161 B8): the investigation, the
+// sign-in-failed screen, and a root placeholder. The API is called with the session cookie only (B5).
+
+const ATTEMPT_KEY = "defender.signin-attempt";
+
+type Storage_ = { ok: true; had: boolean } | { ok: false };
+
+// B1: read the attempt record once at load and delete it.
+function takeAttempt(): Storage_ {
+  try {
+    const had = window.sessionStorage.getItem(ATTEMPT_KEY) !== null;
+    window.sessionStorage.removeItem(ATTEMPT_KEY);
+    return { ok: true, had };
+  } catch {
+    return { ok: false };
+  }
+}
+
+function recordAttempt(): boolean {
+  try {
+    window.sessionStorage.setItem(ATTEMPT_KEY, "1");
+    return window.sessionStorage.getItem(ATTEMPT_KEY) === "1";
+  } catch {
+    return false;
+  }
+}
+
+function signInUrl(back: string | null): string {
+  return back ? `/api/auth/login?return=${encodeURIComponent(back)}` : "/api/auth/login";
+}
+
+function el(tag: string, attrs: Record<string, string> = {}, text = ""): HTMLElement {
+  const node = document.createElement(tag);
+  for (const [k, v] of Object.entries(attrs)) node.setAttribute(k, v);
+  node.textContent = text;
+  return node;
+}
+
+function show(...nodes: HTMLElement[]): void {
+  const app = document.getElementById("app")!;
+  app.replaceChildren(...nodes);
+}
+
+// A path the frontend may send the browser back to: one leading "/", not "//" or "/\".
+function localPath(value: string | null): string | null {
+  if (!value || !value.startsWith("/") || value.startsWith("//") || value.startsWith("/\\")) return null;
+  return value;
+}
+
+function failedScreen(reason: string, back: string | null): void {
+  const message: Record<string, string> = {
+    "unknown-account": "This account is not known here.",
+    "otp-required": "Administrators sign in with a one-time code; sign in again.",
+    "unavailable": "Sign-in is unavailable right now.",
+    "prelogin-missing": "There is no sign-in in progress.",
+    "login-attempt-invalid": "The sign-in could not be completed.",
+    "session-lost": "You were signed in but the session was not accepted.",
+    "storage-unavailable": "This browser does not let the page remember a sign-in attempt.",
+  };
+  const retry = el("button", { "data-testid": "sign-in-retry" }, "Sign in again");
+  retry.addEventListener("click", () => {
+    recordAttempt();
+    window.location.assign(signInUrl(back));
+  });
+  show(el("h1", {}, "Sign-in failed"),
+    el("p", { "data-testid": "sign-in-failed", "data-reason": reason }, message[reason] ?? `Sign-in failed (${reason}).`),
+    retry);
+}
+
+// Send the person to the sign-in-failed screen keeping where they were going (never this screen's own address).
+function goToFailed(reason: string, back: string): void {
+  const query = new URLSearchParams({ reason, return: back });
+  window.location.replace(`/sign-in-failed?${query}`);
+}
+
+interface InvestigationView {
+  investigation_id: string;
+  status: string;
+  disposition: string | null;
+}
+
+async function investigationScreen(tenant: string, investigation: string): Promise<void> {
+  const attempt = takeAttempt();
+  const here = window.location.pathname + window.location.search;
+  show(el("p", {}, "Loading..."));
+  // The load's first API answer is /api/me's (the design's flow); the investigation is read only once signed in.
+  const me = await fetch("/api/me", { credentials: "same-origin" });
+  if (me.status === 401) {
+    if (!attempt.ok) return goToFailed("storage-unavailable", here);
+    if (attempt.had) return goToFailed("session-lost", here);
+    if (!recordAttempt()) return goToFailed("storage-unavailable", here);
+    window.location.replace(signInUrl(here));
+    return;
+  }
+  const response = await fetch(`/api/tenants/${encodeURIComponent(tenant)}/investigations/${encodeURIComponent(investigation)}`,
+    { credentials: "same-origin" });
+  if (!response.ok) {
+    show(el("h1", {}, "Investigation"), el("p", { "data-testid": "not-available" }, "This investigation is not available."));
+    return;
+  }
+  const view = (await response.json()) as InvestigationView;
+  show(el("h1", {}, "Investigation"),
+    el("p", { "data-testid": "investigation-id" }, view.investigation_id),
+    el("p", { "data-testid": "status" }, `Status: ${view.status}`),
+    el("p", { "data-testid": "outcome" }, `Outcome: ${view.disposition ?? "none yet"}`));
+}
+
+function failedRoute(): void {
+  takeAttempt();
+  const params = new URLSearchParams(window.location.search);
+  failedScreen(params.get("reason") ?? "unknown", localPath(params.get("return")));
+}
+
+function route(): void {
+  const path = window.location.pathname;
+  const investigation = /^\/t\/([^/]+)\/investigations\/([^/]+)\/?$/.exec(path);
+  if (investigation) {
+    void investigationScreen(decodeURIComponent(investigation[1]), decodeURIComponent(investigation[2]));
+  } else if (path === "/sign-in-failed") {
+    failedRoute();
+  } else {
+    takeAttempt();
+    show(el("h1", {}, "Defender"));
+  }
+}
+
+route();
