diff --git a/defender/frontend/Caddyfile b/defender/frontend/Caddyfile
new file mode 100644
index 000000000..04445836b
--- /dev/null
+++ b/defender/frontend/Caddyfile
@@ -0,0 +1,27 @@
+# The ingress: the built frontend for every path outside /api, the API for /api (#1161 B9, Am-1).
+# Deployment-specific values come from the environment:
+#   DEFENDER_INGRESS_ADDRESS  the site address (http://localhost:PORT in tests, a TLS hostname in deployment)
+#   DEFENDER_INGRESS_API      the API's upstream, host:port
+#   DEFENDER_INGRESS_ROOT     the built frontend folder (dist/)
+#   DEFENDER_ARTIFACT_DOMAIN  the artifact domain the CSP's form-action names
+#   DEFENDER_INGRESS_ADMIN    Caddy's admin endpoint ("off" to disable)
+{
+	admin {$DEFENDER_INGRESS_ADMIN:localhost:2019}
+}
+
+{$DEFENDER_INGRESS_ADDRESS} {
+	@api path /api /api/*
+	handle @api {
+		reverse_proxy {$DEFENDER_INGRESS_API}
+	}
+	handle {
+		header {
+			Content-Security-Policy "default-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self' https://*.{$DEFENDER_ARTIFACT_DOMAIN}"
+			Referrer-Policy "strict-origin-when-cross-origin"
+			X-Content-Type-Options "nosniff"
+		}
+		root * {$DEFENDER_INGRESS_ROOT}
+		try_files {path} /index.html
+		file_server
+	}
+}
