@@ -0,0 +1,212 @@
+"""#1161 piece 1, test-only: the identity provider's front channel and its authorization-code exchange, over
+`FakeKeycloak` (whose back channel models only discovery, keys, client credentials and the admin API).
+
+The authorize step and the code grant are modelled from Keycloak's OIDC documentation, UNOBSERVED on the dev
+Keycloak: the front channel redirects to `redirect_uri` with `code`, `state`, `session_state` and `iss`; the token
+endpoint takes `grant_type=authorization_code` with HTTP basic client authentication, the code, the PKCE verifier and
+the same `redirect_uri`, and answers an ID token. Codes here are self-describing (a JSON document, base64url), so the
+front channel (in the test process) and the exchange (in the API's process) share no state. Unlike Keycloak, a code
+is not refused on reuse."""
+from __future__ import annotations
+
+import base64
+import datetime as dt
+import hashlib
+import json
+import os
+import sys
+import urllib.parse
+from collections.abc import Iterable
+from http.cookies import SimpleCookie
+from typing import Any
+
+import httpx
+import jwt
+
+from defender.tests.support.api._server1083 import (
+    FAULTS_ENV,
+    PROGRAMS_REALM,
+    SIGNIN_REALM,
+    SIGNING_KID,
+    Child,
+    Fail,
+    FakeKeycloak,
+    fails_to_json,
+)
+
+#: `environment()`'s sign-in client and the secret its file holds (the file's text, stripped).
+CLIENT_ID, CLIENT_SECRET = "defender-api", "signin-client-secret-value"
+
+
+def _b64(raw: bytes) -> str:
+    return base64.urlsafe_b64encode(raw).rstrip(b"=").decode()
+
+
+def _unb64(text: str) -> bytes:
+    return base64.urlsafe_b64decode(text + "=" * (-len(text) % 4))
+
+
+def authorize(url: str, account_id: str, *, amr: Iterable[str] = ("pwd",), name: str = "") -> str:
+    """Where the front channel sends the browser after the password prompt, for the authorize `url` the API built:
+    its `redirect_uri` with a code for `account_id` and its `state`."""
+    split = urllib.parse.urlsplit(url)
+    query = dict(urllib.parse.parse_qsl(split.query))
+    assert query.get("response_type") == "code", query
+    assert query.get("code_challenge_method") == "S256", query
+    code = _b64(json.dumps({"sub": account_id, "nonce": query["nonce"], "challenge": query["code_challenge"],
+                            "redirect_uri": query["redirect_uri"], "amr": list(amr), "name": name}).encode())
+    issuer = f"{split.scheme}://{split.netloc}{split.path.split('/protocol/')[0]}"
+    back = {"state": query["state"], "session_state": "s-1161", "iss": issuer, "code": code}
+    return f"{query['redirect_uri']}?{urllib.parse.urlencode(back)}"
+
+
+def _refused(error: str) -> httpx.Response:
+    return httpx.Response(400, json={"error": error, "error_description": "Code not valid"})
+
+
+def exchange(keycloak: FakeKeycloak, request: httpx.Request) -> httpx.Response:
+    """The sign-in realm's token step: the code grant as above; anything else as the fake answers it."""
+    form = urllib.parse.parse_qs(request.content.decode())
+    if form.get("grant_type") != ["authorization_code"]:
+        return keycloak._token(SIGNIN_REALM, request, keycloak.fails.get((SIGNIN_REALM, "token")))  # type: ignore[return-value]
+    if keycloak._basic_client(request) != (CLIENT_ID, CLIENT_SECRET):
+        return httpx.Response(401, json={"error": "unauthorized_client"})
+    try:
+        code = json.loads(_unb64(form["code"][0]))
+    except (KeyError, ValueError):
+        return _refused("invalid_grant")
+    verifier = form.get("code_verifier", [""])[0]
+    if _b64(hashlib.sha256(verifier.encode()).digest()) != code["challenge"]:
+        return _refused("invalid_grant")
+    if form.get("redirect_uri") != [code["redirect_uri"]]:
+        return _refused("invalid_grant")
+    now = dt.datetime.now(dt.UTC)
+    claims = {"iss": keycloak.issuer(SIGNIN_REALM), "aud": CLIENT_ID, "azp": CLIENT_ID, "sub": code["sub"],
+              "nonce": code["nonce"], "name": code["name"], "amr": code["amr"], "typ": "ID",
+              "iat": int(now.timestamp()), "exp": int((now + dt.timedelta(minutes=5)).timestamp())}
+    token = jwt.encode(claims, keycloak.signing_keys[SIGNIN_REALM], algorithm="RS256", headers={"kid": SIGNING_KID})
+    return httpx.Response(200, json={"access_token": "at-1161", "id_token": token, "token_type": "Bearer",
+                                     "expires_in": 300})
+
+
+def exchanging(keycloak: FakeKeycloak) -> FakeKeycloak:
+    """`keycloak` with the code grant installed on the sign-in realm's token step."""
+    keycloak.answers[(SIGNIN_REALM, "token")] = lambda request: exchange(keycloak, request)
+    return keycloak
+
+
+async def link_account(dsn: str, email: str) -> str:
+    """Record a sign-in account for the user `email` (the seed makes users without one); returns its id."""
+    from defender.identity.postgres import PostgresIdentityRepository
+
+    account_id = f"kc-{hashlib.sha256(email.encode()).hexdigest()[:16]}"
+    repo = PostgresIdentityRepository(dsn)
+    try:
+        user = await repo.user_by_email(email)
+        assert user is not None, email
+        assert await repo.record_signin_account(user.id, account_id)
+        return account_id
+    finally:
+        await repo.close()
+
+
+def set_cookies(response: httpx.Response) -> dict[str, Any]:
+    """Each `Set-Cookie` of `response` as a morsel, by name (a later one of a name wins)."""
+    found: dict[str, Any] = {}
+    for header in response.headers.get_list("set-cookie"):
+        jar: SimpleCookie = SimpleCookie()
+        jar.load(header)
+        found.update(jar)
+    return found
+
+
+def deleted(morsel: Any) -> bool:
+    """Whether a `Set-Cookie` removes its cookie (a zero max-age or an expiry in the past)."""
+    if morsel["max-age"] not in ("", None):
+        return int(morsel["max-age"]) <= 0
+    if morsel["expires"]:
+        from email.utils import parsedate_to_datetime
+
+        return parsedate_to_datetime(morsel["expires"]) <= dt.datetime.now(dt.UTC)
+    return False
+
+
+#: The child's front-channel origin travels in this variable; it is not a setting of the program.
+FRONT_ENV = "CF1161_FRONT"
+
+
+def child(environ: dict[str, str], front: str, fails: Iterable[Fail] = ()) -> Child:
+    """The API program over an exchanging `FakeKeycloak` whose issuers are on `front`, through this module's entry
+    (as `Child.faked`). `environ`'s issuers are moved to `front`."""
+    issuers = {"DEFENDER_KEYCLOAK_ISSUER": f"{front}/realms/{SIGNIN_REALM}",
+               "DEFENDER_KEYCLOAK_PROGRAMS_ISSUER": f"{front}/realms/{PROGRAMS_REALM}"}
+    return Child([sys.executable, "-m", "defender.tests.support.api._signin1161"],
+                 {**environ, **issuers, FRONT_ENV: front, FAULTS_ENV: fails_to_json(fails)}, holds=True)
+
+
+class FrontChannel:
+    """The identity provider's front channel on a loopback port (`origin`): every authorize request is answered with
+    the redirect `authorize()` builds for `account`. While `hold` is set each one is parked until `release(i)`, in
+    any order. `seen` keeps each authorize URL. A browser's route cannot stand in: Playwright does not route a
+    request reached by a server redirect (probed: the browser connects for real)."""
+
+    def __init__(self) -> None:
+        import http.server
+        import threading
+
+        self.account: str | None = None
+        self.hold = False
+        self.seen: list[str] = []
+        self.parked: list[threading.Event] = []
+        outer = self
+
+        class Handler(http.server.BaseHTTPRequestHandler):
+            def log_message(self, *_a: Any) -> None:
+                pass
+
+            def do_GET(self) -> None:  # noqa: N802 — http.server's dispatch name
+                url = f"{outer.origin}{self.path}"
+                if not self.path.startswith(f"/realms/{SIGNIN_REALM}/protocol/openid-connect/auth?"):
+                    self.send_response(404)
+                    self.end_headers()
+                    return
+                outer.seen.append(url)
+                if outer.hold:
+                    event = threading.Event()
+                    outer.parked.append(event)
+                    event.wait(60)
+                assert outer.account is not None
+                self.send_response(302)
+                self.send_header("Location", authorize(url, outer.account))
+                self.send_header("Content-Length", "0")
+                self.end_headers()
+
+        self._server = http.server.ThreadingHTTPServer(("127.0.0.1", 0), Handler)
+        self.origin = f"http://localhost:{self._server.server_address[1]}"
+        threading.Thread(target=self._server.serve_forever, daemon=True).start()
+
+    def release(self, index: int) -> None:
+        self.parked[index].set()
+
+    def close(self) -> None:
+        for event in self.parked:
+            event.set()
+        self._server.shutdown()
+        self._server.server_close()
+
+
+def _main() -> int:
+    from defender.api_server import run
+    from defender.tests.support.api._server1083 import fails_from_json
+
+    fails = fails_from_json(os.environ[FAULTS_ENV]) if FAULTS_ENV in os.environ else ()
+    front = os.environ.get(FRONT_ENV)
+    keycloak = FakeKeycloak(fails) if front is None else FakeKeycloak(fails, front=front)
+    returned = run(os.environ, transport=exchanging(keycloak))
+    print(f"run returned {returned}", flush=True)
+    sys.stdin.readline()
+    return returned
+
+
+if __name__ == "__main__":
+    raise SystemExit(_main())
