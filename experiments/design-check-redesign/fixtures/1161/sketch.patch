+"""#1161 piece 1: signing in from a link, in a headless browser, through the repo's ingress in front of the built
+frontend and the API's real program (B1, B3, B5, B7, B8, B9; D6).
+
+The identity provider's front channel is a loopback server answering the authorize URL with the redirect Keycloak
+would send (`_signin1161.FrontChannel`); its back channel is `FakeKeycloak` with the code grant, in the API's process. Needs
+Playwright with Chromium, Caddy (`caddy` on PATH or `CF1161_CADDY`), npm, and PostgreSQL; the frontend and its
+Caddyfile are the product's (missing before #1161 is implemented: a failure naming the path, not a skip)."""
+from __future__ import annotations
+
+import contextlib
+import dataclasses
+import datetime as dt
+import time
+import urllib.parse
+from collections.abc import Iterator
+from pathlib import Path
+from typing import Any
+
+import anyio
+import httpx
+import pytest
+
+from defender.tests.support.api._server1083 import (
+    A,
+    ANN,
+    B,
+    BOB,
+    SESSION_COOKIE,
+    Seeded,
+    environment,
+    free_port,
+    seed_identity,
+)
+from defender.tests.support.api._signin1161 import FrontChannel, child, link_account
+from defender.tests.support.frontend import _ingress1161 as I
+from defender.tests.support.jobs._jobs1342 import ALERT_BYTES, job_store, register_tenant
+from defender.tests.support.shared._postgres1339 import execute
+
+pytestmark = pytest.mark.postgres
+
+#: The screens' hooks a test finds them by (sketch FC-9: the design names no markup).
+FAILED, RETRY = "[data-testid=sign-in-failed]", "[data-testid=sign-in-retry]"
+WAIT_MS = 30_000
+_NOW = dt.datetime(2026, 11, 1, 12, tzinfo=dt.UTC)
+
+
+@dataclasses.dataclass
+class Stack:
+    origin: str
+    dsn: str
+    seeded: Seeded
+    accounts: dict[str, str]
+    investigation: str
+    api: Any
+    front: FrontChannel
+
+    def screen(self, investigation: str | None = None, query: str = "") -> str:
+        """An investigation screen's address (S2), as a path with its query."""
+        return f"/t/{A}/investigations/{investigation or self.investigation}{query}"
+
+
+@pytest.fixture(scope="session")
+def built() -> Path:
+    if I.caddy() is None:
+        pytest.skip("no caddy (CF1161_CADDY or PATH)")
+    if not (I.FRONTEND / "package.json").is_file():
+        pytest.fail(f"no frontend at {I.FRONTEND} (#1161 B8)")
+    if not I.CADDYFILE.is_file():
+        pytest.fail(f"no ingress config at {I.CADDYFILE} (#1161 Am-1)")
+    return I.build()
+
+
+async def _completed(dsn: str, tenant: str) -> str:
+    """A `completed` investigation with disposition `malicious`, through the store's own claim and finish."""
+    async with job_store(dsn) as store:
+        alert = await store.insert_alert(tenant, vendor="elastic", vendor_ticket_id="T-1161", fired_at=_NOW,
+                                         changed_at=_NOW, received_at=_NOW, raw=ALERT_BYTES)
+        inv, _ = await store.create_investigation(tenant, str(alert.alert_id), "seed", actor="seed")
+        await store.claim()
+        await store.finish(tenant, inv.investigation_id, stage="completed", disposition="malicious", cost_usd=0.0)
+    return str(inv.investigation_id)
+
+
+@pytest.fixture
+def stack(built: Path, migrated_database: str, tmp_path: Path) -> Iterator[Stack]:
+    """Tenants A and B, Ann (A) and Bob (B) with sign-in accounts, a completed investigation of A; the API's program
+    and the ingress in front of it and the build. The frontend origin is the ingress's (sketch FC-4)."""
+    dsn = migrated_database
+    register_tenant(dsn, A)
+    register_tenant(dsn, B)
+    seeded = anyio.run(seed_identity, dsn)
+    accounts = {email: anyio.run(link_account, dsn, email) for email in (ANN, BOB)}
+    investigation = anyio.run(_completed, dsn, A)
+    port, api_port = free_port(), free_port()
+    origin = f"http://localhost:{port}"
+    env = environment(tmp_path, dsn=dsn, port=api_port)
+    env |= {"DEFENDER_API_FRONTEND_ORIGIN": origin, "DEFENDER_KEYCLOAK_REDIRECT_URI": f"{origin}/api/auth/callback"}
+    front = FrontChannel()
+    api = child(env, front.origin)
+    try:
+        with I.ingress(I.CADDYFILE, built, port=port, api=f"127.0.0.1:{api_port}", work=tmp_path) as served:
+            _until_api(served, api)
+            yield Stack(served, dsn, seeded, accounts, investigation, api, front)
+    finally:
+        api.kill()
+        front.close()
+
+
+def _until_api(origin: str, api: Any) -> None:
+    """Until the API answers through the ingress: a signed-out `/api/me` is the API's 401 problem."""
+    deadline = time.monotonic() + 60
+    while time.monotonic() < deadline:
+        assert api.process.poll() is None, api.ended().stderr
+        with contextlib.suppress(httpx.TransportError):
+            if httpx.get(f"{origin}/api/me", timeout=2).status_code == 401:
+                return
+        time.sleep(0.3)
+    raise AssertionError("the API never answered through the ingress")
+
+
+@pytest.fixture(scope="session")
+def chromium() -> Iterator[Any]:
+    sync_api = pytest.importorskip("playwright.sync_api")
+    with sync_api.sync_playwright() as pw:
+        browser = pw.chromium.launch()
+        yield browser
+        browser.close()
+
+
+class Browsing:
+    """A fresh browser profile on the stack, the front channel signing in `account`; every request kept."""
+
+    def __init__(self, chromium: Any, stack: Stack, account: str) -> None:
+        self.stack = stack
+        stack.front.account = account
+        self.context = chromium.new_context()
+        self.context.set_default_timeout(WAIT_MS)
+        self.requests: list[Any] = []
+        self.context.on("request", self.requests.append)
+
+    def logins(self) -> list[str | None]:
+        """The `return` of each sign-in start the browser made, in order."""
+        found = []
+        for r in self.requests:
+            split = urllib.parse.urlsplit(r.url)
+            if f"{split.scheme}://{split.netloc}" == self.stack.origin and split.path == "/api/auth/login":
+                found.append(dict(urllib.parse.parse_qsl(split.query)).get("return"))
+        return found
+
+    def api_calls(self) -> list[Any]:
+        return [r for r in self.requests if urllib.parse.urlsplit(r.url).path.startswith("/api/")
+                and not urllib.parse.urlsplit(r.url).path.startswith("/api/auth/")]
+
+
+@pytest.fixture
+def browsing(chromium: Any, stack: Stack) -> Iterator[Browsing]:
+    b = Browsing(chromium, stack, stack.accounts[ANN])
+    yield b
+    b.context.close()
+
+
+def _wait_held(page: Any, browsing: Browsing, count: int) -> None:
+    deadline = time.monotonic() + WAIT_MS / 1000
+    while len(browsing.stack.front.parked) < count:
+        assert time.monotonic() < deadline, f"no sign-in reached the identity provider: {browsing.logins()}"
+        page.wait_for_timeout(100)
+
+
+# --- B8 / B1 / B7: the ticket link --------------------------------------------------------------------
+
+@pytest.mark.parametrize("query", ["", "?from=ticket&x=a.b"], ids=["path", "path-and-query"])
+def test_1161_b8_a_ticket_link_opened_signed_out_lands_signed_in_on_its_investigation_screen(stack, browsing, query):
+    """Signed out → one sign-in → back at exactly the address followed, showing the investigation's status and
+    outcome; the page calls the API with the cookie only. (B8, B1, B7, B5, S3)"""
+    from playwright.sync_api import expect
+
+    target = stack.screen(query=query)
+    page = browsing.context.new_page()
+    page.goto(f"{stack.origin}{target}")
+
+    body = page.locator("body")
+    expect(body).to_contain_text("malicious")  # the screen after sign-in: the address before it already matched
+    expect(body).to_contain_text("completed")
+    assert page.url == f"{stack.origin}{target}"  # nothing added to the shareable address
+    assert browsing.logins() == [target]
+    assert SESSION_COOKIE in {c["name"] for c in browsing.context.cookies()}
+    calls = browsing.api_calls()
+    assert calls, "positive control: the screen called the API"
+    for call in calls:
+        assert urllib.parse.urlsplit(call.url).netloc == urllib.parse.urlsplit(stack.origin).netloc, call.url
+        assert "authorization" not in {h.lower() for h in call.all_headers()}, call.url
+
+
+def test_1161_b1_a_401_after_sign_in_shows_sign_in_failed_and_retries_only_on_request(stack, browsing):
+    """The session is gone by the first API call after sign-in: the screen shows sign-in-failed instead of a second
+    automatic sign-in; its retry starts sign-in for the kept address. (B1, B8)"""
+    target = stack.screen(query="?from=ticket")
+    signed_in: list[bool] = []
+
+    def revoke(route: Any) -> None:
+        if signed_in:  # after the callback: the session dies before the API can read it (a real revocation)
+            execute(stack.dsn, "DELETE FROM identity.sessions")
+        route.continue_()
+
+    browsing.context.on("response", lambda r: signed_in.append(True) if "/api/auth/callback" in r.url else None)
+    browsing.context.route(
+        lambda url: urllib.parse.urlsplit(url).path.startswith("/api/")
+        and not urllib.parse.urlsplit(url).path.startswith("/api/auth/"), revoke)
+    page = browsing.context.new_page()
+    page.goto(f"{stack.origin}{target}")
+
+    page.locator(FAILED).wait_for()
+    page.wait_for_timeout(1500)  # long enough for a second automatic attempt to show
+    assert browsing.logins() == [target]
+    page.locator(RETRY).click()
+    page.wait_for_url(lambda url: len(browsing.logins()) == 2)
+    assert browsing.logins() == [target, target]
+
+
+def test_1161_b8_d6_two_tabs_opened_signed_out_each_land_on_their_own_address(stack, browsing):
+    """Two new tabs start sign-in before either completes; completed in the other order, each lands on its own
+    address (one pre-login cookie per attempt). (B8, D6, S3)"""
+    first, second = stack.screen(query="?tab=1"), stack.screen(query="?tab=2")
+    stack.front.hold = True
+    one = browsing.context.new_page()
+    one.goto(f"{stack.origin}{first}", wait_until="commit")
+    _wait_held(one, browsing, 1)
+    two = browsing.context.new_page()
+    two.goto(f"{stack.origin}{second}", wait_until="commit")
+    _wait_held(two, browsing, 2)
+
+    stack.front.release(1)
+    two.locator("body").filter(has_text="malicious").wait_for()  # tab two done before tab one resumes
+    assert two.url == f"{stack.origin}{second}"
+    stack.front.release(0)
+    one.locator("body").filter(has_text="malicious").wait_for()
+    assert one.url == f"{stack.origin}{first}"
+    assert sorted(browsing.logins()) == sorted([first, second])
+
+
+def test_1161_b7_a_signed_in_non_member_is_not_shown_the_investigation_and_not_sent_to_sign_in_again(chromium, stack):
+    """Bob (tenant B) follows A's link: he signs in once, then sees no status of A's investigation. (B7; FC-8)"""
+    b = Browsing(chromium, stack, stack.accounts[BOB])
+    try:
+        target = stack.screen()
+        page = b.context.new_page()
+        read = f"/api/tenants/{A}/investigations/{stack.investigation}"
+        with page.expect_response(lambda r: urllib.parse.urlsplit(r.url).path == read):
+            page.goto(f"{stack.origin}{target}")
+        page.wait_for_timeout(1000)  # the screen renders its answer to the read
+        assert b.logins() == [target]
+        assert [c.response().status for c in b.api_calls() if c.response() is not None and
+                f"/investigations/{stack.investigation}" in c.url] == [404]
+        assert "malicious" not in page.locator("body").inner_text()
+    finally:
+        b.context.close()
+
+
+# --- B9 / B3 through the ingress ------------------------------------------------------------------------
+
+@pytest.mark.parametrize("path", ["/", "/t/x/investigations/y?z=1", "/me", "/auth/login", "/apix", "/no/such/screen"])
+def test_1161_b9_the_ingress_serves_the_app_with_its_headers_for_every_path_outside_api(stack, path):
+    """Every non-`/api` path is the app's document, with the CSP form-action and the Referrer-Policy B9 names. (B9)"""
+    r = httpx.get(f"{stack.origin}{path}")
+    assert r.status_code == 200, (r.status_code, r.headers)
+    assert r.headers["content-type"].startswith("text/html"), (r.status_code, r.headers)
+    assert r.text == httpx.get(f"{stack.origin}/").text, "not the app's one document"
+    assert r.headers.get("referrer-policy") == "strict-origin-when-cross-origin", r.headers
+    [form_action] = [d.split()[1:] for d in r.headers["content-security-policy"].split(";")
+                     if d.split() and d.split()[0] == "form-action"]
+    assert sorted(form_action) == sorted(["'self'", f"https://*.{I.ARTIFACT_DOMAIN}"]), form_action
+
+
+def test_1161_b3_b9_through_the_ingress_api_paths_reach_the_api_and_its_locations_read_back(stack):
+    """`/api` goes to the API (a problem, not the app); create_tenant's `Location` reads back through it. (B3, B9)"""
+    signed_out = httpx.get(f"{stack.origin}/api/me")
+    assert (signed_out.status_code, signed_out.headers["content-type"]) == (401, "application/problem+json")
+    ops = {"Cookie": f"{SESSION_COOKIE}={stack.seeded.ops_session}", "Origin": stack.origin}
+    created = httpx.post(f"{stack.origin}/api/admin/tenants", headers=ops)
+    assert created.status_code == 202, created.text
+    read = httpx.get(urllib.parse.urljoin(f"{stack.origin}/api/admin/tenants", created.headers["location"]),
+                     headers=ops)
+    assert read.status_code == 200, read.text
+    assert read.json()["tenant_id"] == created.json()["tenant_id"], read.text
