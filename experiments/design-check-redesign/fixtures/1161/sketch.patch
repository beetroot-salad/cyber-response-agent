+"""#1161 piece 1, test-only: the built frontend behind the repo's ingress (Caddy) in front of the API's real program.
+
+Where the frontend and its Caddyfile live, how the frontend is built, and which settings the Caddyfile reads are not
+settled by the design (sketch FC-2, FC-3): the paths and variable names below are the sketch's choice. The Caddyfile is
+expected to read every deployment-specific value from the environment:
+
+- `DEFENDER_INGRESS_ADDRESS`: its site address (here `http://localhost:<port>`: plain http, no automatic TLS);
+- `DEFENDER_INGRESS_API`: the API's upstream (`host:port`), which every `/api` request goes to;
+- `DEFENDER_INGRESS_ROOT`: the built frontend's folder;
+- `DEFENDER_ARTIFACT_DOMAIN`: the artifact domain named in the frontend's CSP (B9);
+- `DEFENDER_INGRESS_ADMIN`: Caddy's admin endpoint (`off` here: parallel tests would collide on :2019)."""
+from __future__ import annotations
+
+import contextlib
+import os
+import shutil
+import subprocess
+import time
+from collections.abc import Iterator
+from pathlib import Path
+
+import httpx
+
+DEFENDER = Path(__file__).resolve().parents[3]
+FRONTEND = DEFENDER / "frontend"
+CADDYFILE = FRONTEND / "Caddyfile"
+ARTIFACT_DOMAIN = "artifacts.defender.test"
+#: Where to find the tools when they are not on PATH (this machine keeps Caddy in a scratch folder).
+CADDY_ENV, NPM = "CF1161_CADDY", "npm"
+
+
+def caddy() -> str | None:
+    return os.environ.get(CADDY_ENV) or shutil.which("caddy")
+
+
+def build(frontend: Path = FRONTEND) -> Path:
+    """The frontend built to static files (`npm ci` once, then `npm run build`); its output folder `dist/`."""
+    run = {"cwd": str(frontend), "check": True, "capture_output": True, "text": True}
+    if not (frontend / "node_modules").is_dir():
+        subprocess.run([NPM, "ci", "--no-audit", "--no-fund"], **run)  # type: ignore[call-overload]
+    subprocess.run([NPM, "run", "build"], **run)  # type: ignore[call-overload]
+    dist = frontend / "dist"
+    assert (dist / "index.html").is_file(), f"the build made no {dist / 'index.html'}"
+    return dist
+
+
+@contextlib.contextmanager
+def ingress(caddyfile: Path, root: Path, *, port: int, api: str, work: Path) -> Iterator[str]:
+    """Caddy running `caddyfile` on `http://localhost:<port>`, serving `root` and sending `/api` to `api`; its origin."""
+    binary = caddy()
+    assert binary is not None, "no caddy"
+    origin = f"http://localhost:{port}"
+    env = {**os.environ, "DEFENDER_INGRESS_ADDRESS": origin, "DEFENDER_INGRESS_API": api,
+           "DEFENDER_INGRESS_ROOT": str(root), "DEFENDER_ARTIFACT_DOMAIN": ARTIFACT_DOMAIN,
+           "DEFENDER_INGRESS_ADMIN": "off", "XDG_DATA_HOME": str(work / "data"), "XDG_CONFIG_HOME": str(work / "config")}
+    log = (work / "caddy.log").open("w")
+    process = subprocess.Popen([binary, "run", "--config", str(caddyfile), "--adapter", "caddyfile"], env=env,
+                               stdout=log, stderr=subprocess.STDOUT)
+    try:
+        deadline = time.monotonic() + 30
+        while True:
+            assert process.poll() is None, (work / "caddy.log").read_text()
+            with contextlib.suppress(httpx.TransportError):
+                httpx.get(f"{origin}/", timeout=2)
+                break
+            assert time.monotonic() < deadline, "caddy never answered"
+            time.sleep(0.2)
+        yield origin
+    finally:
+        process.terminate()
+        try:
+            process.wait(10)
+        except subprocess.TimeoutExpired:
+            process.kill()
+            process.wait()
+        log.close()
