# Keep docker build contexts lean. Applies to any build whose context is the repo
# root — the dev image (.devcontainer/Dockerfile.dev) and the runtime image
# (.devcontainer/Dockerfile.runtime) both build with `context: ../`. The box image
# (defender/box.Dockerfile) does NOT: its context is `defender/` (#1098), so this
# file never applies to it. Exclude-list, not an allowlist, so adding a COPY later
# doesn't silently lose files.

# VCS + worktrees
.git
.worktrees

# Python build/venv/caches (the runtime image builds its own .venv fresh)
**/.venv
**/__pycache__
**/*.pyc
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache

# JS deps
**/node_modules

# Transient / large local state — never needed to build the agent
defender/learning/runs
defender/run-transcripts
.defender-runs
/tmp

# Playground stack data + local infra state
playground-v2/**/data
**/*.tfstate
**/*.tfstate.*

# Secrets / local env — supplied at RUN time (--env-file), never at build
.env
*.env.bak
.ssh
