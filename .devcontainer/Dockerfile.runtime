# Lightweight defender RUNTIME image — the "application container", deliberately
# distinct from the dev container (.devcontainer/Dockerfile.dev).
#
# WHY SEPARATE. The dev container carries the toolchain (terraform, hcloud, codex,
# docker CLI, ssh) plus the interactive session; the runtime is where an
# investigation actually executes (defender/run.py) and — per the sandbox design
# (defender/docs/runtime-sandbox-design.md) — the eventual untrusted "hands" whose
# rootfs should be minimal. So this image carries ONLY python + the defender
# runtime deps (plus the `api` extra the credential proxy serves with, #1482) + the defender code. No dev tooling, no egress tooling. Two tools are carried
# because the worker needs them (#1344 "One image"): git, for the tenant clones the runs and the
# learning jobs read, and the docker CLI, which starts each run's box (mount the host's Docker
# socket). The worker runs learning as its own child processes, so there is one image.
#
# NO TENANT DATA (#1106, #1120). Each tenant's knowledge folder
# (`$DEFENDER_DATA_ROOT/<id>/knowledge/`, a clone of the tenant's own repo) holds its
# settings — endpoints, and later credentials — and its model-facing knowledge. It is
# deployment data, not code, so it is never baked into an image (an image would carry
# every tenant's settings, and go stale the moment one changes). The data root is
# MOUNTED at run time and named by DEFENDER_DATA_ROOT. `.dockerignore` keeps `knowledge/`
# and `.defender-data` out of the build context so a later COPY cannot bake it in.
#
# HOW IT'S BUILT/RUN. From the dev container (via the mounted docker socket) or
# straight from the host, context = repo root:
#   docker build -f .devcontainer/Dockerfile.runtime -t defender-runtime .
# Hermetic replay smoke test (no key, no egress; the replays run as the committed test
# fixture tenant, `knowledge/tenant-fixture`, so the repo's `knowledge/` is mounted):
#   docker run --rm -v "<HOST_REPO_PATH>/knowledge":/workspace/knowledge:ro \
#       defender-runtime defender/.venv/bin/python -m pytest defender -m e2e
# The deployed command is the worker (#1344 O15): it reads DEFENDER_DATABASE_DSN, DEFENDER_DATA_ROOT,
# DEFENDER_BUILD_COMMIT (baked, below), DEFENDER_WORKER_SLOTS (default 3) and
# DEFENDER_WORKER_LEARNING_SLOTS (default min(1, slots - 1)) and DEFENDER_WORKER_LEARNING_CHECK_SECONDS
# (default 300: a tenant with no post-step that long is checked without a family); it refuses a build stamp that is not a
# commit (7 to 64 lowercase hex characters, the copy marker's own grammar: no tag, branch name or suffix), takes
# a lock on the data root (one worker per machine), replaces its read-only code copy under the data
# root, and runs every investigation and learning child from that copy:
#   docker run --rm --env-file .env -e DEFENDER_DATABASE_DSN=... -e DEFENDER_DATA_ROOT=/data \
#       -v "<HOST_DATA_ROOT>":/data -v /var/run/docker.sock:/var/run/docker.sock defender-runtime
# The data root must be mounted at the same path the Docker daemon sees, since boxes mount the copy,
# and the worker's uid must own it (git refuses a tenant clone it does not own).
# One investigation by hand (needs the LLM key and the data root; egress is NOT baked in):
#   docker run --rm --env-file .env -e DEFENDER_DATA_ROOT=/data -v "<HOST_DATA_ROOT>":/data \
#       defender-runtime python3 defender/run.py <alert.json> --tenant <id>
#
# EGRESS CAVEAT. Live gather currently shells out to `docker --context
# soc-playground exec … curl` (mode-2 in the design). That egress is deliberately
# NOT in this image — credentialed egress belongs behind the broker, not baked into
# the untrusted runtime surface. Until the broker exists, mount what a live gather
# needs at run time rather than baking it in, e.g.
#   -v /var/run/docker.sock:/var/run/docker.sock -v "$HOME/.ssh":/root/.ssh:ro
#
# LIVE ITERATION. Code is baked so the image is self-contained; to iterate without
# rebuilding, mount the workspace over it — run.py finds defender/.venv at the same
# path either way:
#   docker run --rm -v "<HOST_REPO_PATH>":/workspace defender-runtime …
# (from the dev container use the HOST repo path, not the container's /workspace —
# the daemon resolves bind sources host-side.)

FROM python:3.11-slim

# curl + ca-certificates: uv bootstrap and TLS to the model API; git: the tenant clones (#1344).
# The runtime imports no libmagic, and dev/egress tooling stays out by design.
RUN apt-get update && apt-get install -y --no-install-recommends \
        curl ca-certificates git \
    && rm -rf /var/lib/apt/lists/*

# The docker CLI alone (no daemon): the worker starts each run's box through the host's socket (#1344).
COPY --from=docker:27.3.1-cli /usr/local/bin/docker /usr/local/bin/docker

RUN pip install --no-cache-dir uv

WORKDIR /workspace

# Deps layer first, cached across code changes: resolve the `.[runtime]` and `.[api]` extras
# from the committed lock into defender/.venv — the exact venv path run.py
# re-execs into (defender/run.py:28). `api` too (#1482): the dev compose's credential
# proxy runs from this image, and it serves over fastapi and uvicorn, which only `api` brings.
COPY defender/pyproject.toml defender/uv.lock defender/
RUN cd defender && uv sync --frozen --extra runtime --extra api

# Code layer (busts only when defender/ changes, not on a dep change).
COPY defender/ defender/

# PROVENANCE STAMP (#976). Every run records the commit it was made against, which it normally
# asks git for — and this image has no .git, by design: it is python + the deps + the package
# (git itself is here only for tenant clones), and `.dockerignore` keeps repository metadata out.
#
# Pass it at build time; the build is where the answer is known:
#   docker build -f .devcontainer/Dockerfile.runtime \
#       --build-arg DEFENDER_BUILD_COMMIT="$(git rev-parse HEAD)" -t defender-runtime .
#
# The worker refuses to start without it, or with anything but a commit (#1344 O15). At each start it writes a fresh read-only
# copy of the baked code under the data root with this commit in the copy's marker
# (`.defender-code-copy.json`); its children run from that copy and stamp it as a clean build of
# this commit, read from the marker, never from git. A process started from the baked tree itself
# (a single `run.py` by hand) still recovers the commit with no clean working-tree bit — see
# `defender/records/_provenance.py` — since a workspace mounted over the baked code for live
# iteration means nothing can confirm the bytes on disk are the bytes that were built.
ARG DEFENDER_BUILD_COMMIT=""
ENV DEFENDER_BUILD_COMMIT=$DEFENDER_BUILD_COMMIT

# The deployed process: the worker (#1344 O15). Override the command for a shell or a single run.
CMD ["defender/.venv/bin/python", "-m", "defender.worker"]
