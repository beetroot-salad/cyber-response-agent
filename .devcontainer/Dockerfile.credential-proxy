# The credential proxy's image (#1163, #1482): python, the `credential-proxy` extra and the
# defender code, nothing else. The dev compose's `credential-proxy` service builds it
# (`.devcontainer/docker-compose.yml`, which rebuilds it on every `up` or `run`).
#
# WHY ITS OWN IMAGE. The proxy used to run from the worker's image (`Dockerfile.runtime`), whose
# install had never included the web framework the proxy serves with, so the proxy exited at import
# (#1482). Its own image installs exactly the proxy's extra: the worker image stays free of a web
# framework, and the proxy's image of the investigation stack. Like the runtime image it bakes no
# tenant data; compose mounts the data root read-only at `/data`.
#
# CI's `proxy-image` job starts the service through compose with no configuration file and
# requires the proxy's own refusal (exit 2), not an import failure (exit 1).

FROM python:3.11-slim

# ca-certificates: TLS to OpenBao and to the systems the proxy reaches. No git, no docker CLI.
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir uv

WORKDIR /workspace

# Deps layer first, cached across code changes, from the committed lock into defender/.venv.
COPY defender/pyproject.toml defender/uv.lock defender/
RUN cd defender && uv sync --frozen --extra credential-proxy

COPY defender/ defender/

CMD ["defender/.venv/bin/python", "-m", "defender.credential_proxy"]
