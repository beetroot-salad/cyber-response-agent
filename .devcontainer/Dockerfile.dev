FROM python:3.11-slim

# Install system dependencies including Docker CLI
RUN apt-get update && apt-get install -y \
    build-essential \
    curl \
    git \
    libmagic1 \
    ca-certificates \
    gnupg \
    lsb-release \
    openssh-client \
    netcat-openbsd \
    jq \
    datamash \
    sqlite3 \
    # procps supplies `ps`. Without it VS Code's process-list code falls back to
    # a shell script that forks ~6 processes per PID in /proc, every poll — the
    # runs pile up faster than they finish and bury the box in forks. Keep it.
    # The jobs daemon needs it too: `docker top` runs `ps`, and without that list a
    # job's helper refuses gVisor's own processes as callers (#1475).
    procps \
    && mkdir -p /etc/apt/keyrings \
    && curl -fsSL https://download.docker.com/linux/debian/gpg | gpg --dearmor -o /etc/apt/keyrings/docker.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/debian $(lsb_release -cs) stable" | tee /etc/apt/sources.list.d/docker.list > /dev/null \
    && curl -fsSL https://apt.releases.hashicorp.com/gpg | gpg --dearmor -o /etc/apt/keyrings/hashicorp.gpg \
    && chmod a+r /etc/apt/keyrings/hashicorp.gpg \
    && echo "deb [signed-by=/etc/apt/keyrings/hashicorp.gpg] https://apt.releases.hashicorp.com $(lsb_release -cs) main" | tee /etc/apt/sources.list.d/hashicorp.list > /dev/null \
    && apt-get update \
    # docker-ce + containerd.io + iptables: the dev container's own jobs daemon (below).
    && apt-get install -y docker-ce-cli docker-compose-plugin terraform docker-ce containerd.io iptables \
    && rm -rf /var/lib/apt/lists/*

# The jobs daemon (#1170, #1475): a docker daemon inside this container, for running jobs live. A job's helper must
# share the docker daemon's mount paths and pid namespace (defender/docs/decisions/vps-compose-deployment.md, brain
# confinement); the host daemon behind /var/run/docker.sock shares neither, this one shares both by construction.
# Started on demand by `start-jobs-docker`, on its own socket; see defender/docs/development-operations.md.
# gVisor comes from its own signed apt repository, as CI's .github/actions/install-gvisor installs it, registered
# as CI registers it, twice (#1469): `runsc`, the box runtime, with --oci-seccomp only (boxes are refused without it,
# #771, and no host-socket access); `runsc-job`, the job container's runtime, adds --host-uds=open (the job's socket is a
# unix socket of this container mounted into the job's gVisor guest, which refuses to connect to it without this).
RUN curl -fsSL https://gvisor.dev/archive.key | gpg --dearmor -o /usr/share/keyrings/gvisor-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/gvisor-archive-keyring.gpg] https://storage.googleapis.com/gvisor/releases release main" \
       > /etc/apt/sources.list.d/gvisor.list \
    && apt-get update -o Dir::Etc::sourcelist=/etc/apt/sources.list.d/gvisor.list -o Dir::Etc::sourceparts=/dev/null \
       -o APT::Get::List-Cleanup=0 \
    && apt-get install -y --no-install-recommends runsc \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /etc/docker \
    && printf '%s\n' '{"runtimes": {"runsc": {"path": "/usr/bin/runsc", "runtimeArgs": ["--oci-seccomp"]}, "runsc-job": {"path": "/usr/bin/runsc", "runtimeArgs": ["--oci-seccomp", "--host-uds=open"]}}}' \
       > /etc/docker/daemon.json
COPY .devcontainer/start-jobs-docker.sh /usr/local/bin/start-jobs-docker

# hcloud CLI (Hetzner Cloud)
ARG HCLOUD_VERSION=1.62.2
RUN curl -fsSL "https://github.com/hetznercloud/cli/releases/download/v${HCLOUD_VERSION}/hcloud-linux-amd64.tar.gz" \
    | tar -xz -C /usr/local/bin hcloud \
    && chmod 0755 /usr/local/bin/hcloud

# Codex CLI (OpenAI)
ARG CODEX_VERSION=0.137.0
RUN curl -fsSL "https://github.com/openai/codex/releases/download/rust-v${CODEX_VERSION}/codex-x86_64-unknown-linux-musl.tar.gz" \
    | tar -xz -C /tmp \
    && install -m 0755 /tmp/codex-x86_64-unknown-linux-musl /usr/local/bin/codex \
    && rm /tmp/codex-x86_64-unknown-linux-musl

# Set working directory
WORKDIR /workspace

# Install uv (all Python deps managed via pyproject.toml)
RUN pip install --no-cache-dir uv

# Auto-load /workspace/.env for interactive shells (HCLOUD_TOKEN, WAZUH_*, etc.)
RUN printf '\n# Auto-load /workspace/.env for CLI usage (docker-compose loads it separately).\nif [ -f /workspace/.env ]; then\n    set -a\n    . /workspace/.env\n    set +a\nfi\n' >> /root/.bashrc

# Link SSH config from workspace (resolves at runtime once /workspace is mounted).
# Keys + config live in /workspace/.ssh/ (gitignored) so they persist across rebuilds.
RUN mkdir -p /root/.ssh && chmod 700 /root/.ssh && ln -sf /workspace/.ssh/config /root/.ssh/config

# Development command - start shell by default (uvicorn can be run manually)
CMD ["bash"]
