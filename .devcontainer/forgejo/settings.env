# Forgejo's settings (#1592 "Forgejo configuration"): the `env_file` of compose's `forgejo` service, and what CI's
# `forgejo-live` job starts Forgejo with. `FORGEJO__section__KEY=value` lines only. Forgejo writes these into its
# `app.ini`, where they persist: after changing one, recreate the service (and, for a value removed here, edit or drop
# `app.ini` under the data volume).

FORGEJO__database__DB_TYPE=sqlite3
# Skip the web install wizard; accounts are created with `forgejo admin user create` and by the lifecycle.
FORGEJO__security__INSTALL_LOCK=true
# No "remember me" cookie: a session ends with the browser, at most SESSION_LIFE_TIME after its last use.
FORGEJO__security__LOGIN_REMEMBER_DAYS=0

# The site's public origin: the ingress's Forgejo site (`DEFENDER_FORGE_DOMAIN`, the same name, on the devcontainer
# service) on the ingress's port. `*.localhost` resolves to loopback in Chromium, curl and (through systemd-resolved)
# httpx. Forgejo itself listens on 3000, reached privately by the lifecycle and the bots.
FORGEJO__server__DOMAIN=forge.localhost
FORGEJO__server__ROOT_URL=http://forge.localhost:8000/
FORGEJO__server__HTTP_PORT=3000
# A visitor with no session at `/` is sent to the sign-in page.
FORGEJO__server__LANDING_PAGE=login
# SSH off. The rootful image starts sshd regardless: compose also mounts an empty s6 `down` file over it.
FORGEJO__server__DISABLE_SSH=true

# Authorized Integrations may name only the dev issuer (#1108 P4). Forgejo fetches its discovery and JWKS over HTTPS on
# the compose network, trusting the dev CA the service mounts.
FORGEJO__authorized_integration__ALLOWED_DOMAINS=openbao

# People sign in with their product account only, through the `product` login source (.devcontainer/forgejo/setup.sh),
# to an account the lifecycle made: no registration, no local or basic sign-in, no linking.
FORGEJO__oauth2_client__ENABLE_AUTO_REGISTRATION=false
FORGEJO__oauth2_client__ACCOUNT_LINKING=disabled
FORGEJO__service__DISABLE_REGISTRATION=true
FORGEJO__service__ENABLE_INTERNAL_SIGNIN=false
FORGEJO__service__ENABLE_BASIC_AUTHENTICATION=false
FORGEJO__service__DEFAULT_ALLOW_CREATE_ORGANIZATION=false
FORGEJO__service__REQUIRE_SIGNIN_VIEW=true
FORGEJO__service__ENABLE_NOTIFY_MAIL=false
FORGEJO__admin__EXTERNAL_USER_DISABLE_FEATURES=manage_password

# Sessions live in their own database on the product's PostgreSQL server (.devcontainer/postgres/forgejo-sessions.sql),
# as dev's login in `fs_forgejo`, made by setup.sh.
FORGEJO__session__PROVIDER=postgres
FORGEJO__session__PROVIDER_CONFIG=user=fs_forgejo_dev password=dev-only-change-me host=postgres port=5432 dbname=forgejo_sessions sslmode=disable
FORGEJO__session__SESSION_LIFE_TIME=3600

# Nothing else to create: no repositories, migrations, forks or mirrors.
FORGEJO__repository__MAX_CREATION_LIMIT=0
FORGEJO__repository__DISABLE_MIGRATIONS=true
FORGEJO__repository__DISABLE_FORKS=true
FORGEJO__mirror__ENABLED=false
FORGEJO__mailer__ENABLED=false
