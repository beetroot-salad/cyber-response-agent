# change-mgmt configuration for this tenant — replace every CHANGE-ME before granting change-mgmt any verb.
# Key names are what the change-mgmt adapter reads; see the playground tenant for a worked example.
CHANGE_MGMT_URL_BASE="CHANGE-ME"
CHANGE_MGMT_BASTION_HOST="CHANGE-ME"
CHANGE_MGMT_TIMEOUT_SEC="CHANGE-ME"
