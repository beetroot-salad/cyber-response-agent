# elastic configuration for this tenant — replace every CHANGE-ME before granting elastic any verb.
# Key names are what the elastic adapter reads; see the playground tenant for a worked example.
# Elasticsearch is reached through the credential proxy: its base URL (and `ca`, if its certificate
# comes from a private CA) go in access.yaml beside this file, not here. Set ELASTIC_TRANSPORT to
# "http-proxy": it is the only access method.
ELASTIC_TRANSPORT="CHANGE-ME"
ELASTIC_EVENTS_INDEX="CHANGE-ME"
ELASTIC_ALERTS_INDEX="CHANGE-ME"
ELASTIC_RETENTION_DAYS="CHANGE-ME"
