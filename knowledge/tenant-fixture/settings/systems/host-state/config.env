# Host-state deployment configuration — playground-v2 (Hetzner VPS)
# Read by defender/scripts/adapters/host_state_adapter.py. This adapter runs `docker exec <host>
# <command>` directly (no HTTP, no bastion), so its whole configuration is how it reaches the
# docker daemon. Both lines are required and have no default.
HOST_STATE_TRANSPORT="docker-exec"
HOST_STATE_DOCKER_CONTEXT="soc-playground"
