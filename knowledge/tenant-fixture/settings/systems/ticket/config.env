# ticket stub configuration — playground-v2. Read by defender/integrations/ticket_adapter.py.
# The stub is reached through the credential proxy at the base in access.yaml beside this file.

# How long the proxy gives one request, in seconds.
TICKET_TIMEOUT_SEC="10"
TICKET_KEY_PATTERN="[A-Za-z0-9][A-Za-z0-9._-]*"
