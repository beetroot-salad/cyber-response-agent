# Identity stub deployment configuration — playground-v2 (Hetzner VPS)
# Read by defender/scripts/adapters/identity_adapter.py. No credentials — stubs are
# auth-less on the compose network and are reached via `docker --context
# soc-playground exec`.

IDENTITY_URL_BASE="http://identity:8080"
IDENTITY_BASTION_HOST="web-1"
IDENTITY_TIMEOUT_SEC="10"

# How the host reaches this system: both lines are required and have no default. `docker-exec`
# is the one implemented method; the context is the docker context the compose network is on.
IDENTITY_TRANSPORT="docker-exec"
IDENTITY_DOCKER_CONTEXT="soc-playground"
