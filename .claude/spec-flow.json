{
  "project": "defender — an LLM SOC-analyst agent (python, pytest, uv)",
  "gate": {
    "ciConfig": ".github/workflows/ci.yml",
    "test": "cd defender && uv run pytest tests/ -m \"not llm and not live\"",
    "checks": [
      "defender/.venv/bin/ruff check . --select E,F --ignore E402,E501",
      "defender/.venv/bin/ruff check defender",
      "defender/.venv/bin/mypy --config-file defender/pyproject.toml",
      "the baseline-ratcheted custom lints under scripts/lint/lint_*.py (monkeypatch, unsafe-jsonl-io, raw-git-subprocess, unanchored-default, vulture, duplicate-helpers, …) — each blocks only on a NEW finding, and each documents an inline-suppression escape hatch in its own module"
    ],
    "notes": "`.github/workflows/ci.yml` is the source of truth — run what it runs; don't trust this list to stay current. Running in a git worktree? The shared `.venv` editable install points at the main checkout — prepend `PYTHONPATH=<worktree-root>` to the pytest call or you test the wrong tree."
  },
  "tests": {
    "language": "python",
    "dir": "defender/tests",
    "harness": "defender/tests/e2e/_replay_harness.py — a new scenario is a few lines of `Turn(...)`, not fresh plumbing. Build on it rather than inventing parallel machinery.",
    "idioms": "Fakes enter through the entry point's injection seams (a `deps` parameter, a constructor argument), never `monkeypatch.setattr` — CI ratchets new setattr sites (`scripts/lint/lint_monkeypatch.py`)."
  },
  "specGraph": {
    "artifacts": "spec-flow/specs/spec_graph_*.yaml",
    "codeRoots": [
      "defender/runtime",
      "defender/learning",
      "defender/evals",
      "defender/run.py"
    ],
    "entrypointStems": [
      "loop",
      "run"
    ],
    "contextAliases": {
      "run": "run_investigation",
      "driver": "run_investigation",
      "tools_gather": "gather_dispatch",
      "tools": "tool_write_file"
    },
    "conceptAliases": {},
    "resources": {
      "ticket_store": {
        "writers": [
          "defender/scripts/case_history/ticket_writer.py::open_case_ticket",
          "defender/scripts/case_history/ticket_writer.py::close_case_ticket",
          "defender/scripts/case_history/ticket_writer.py::annotate_case_ticket",
          "defender/scripts/case_history/ticket_writer.py::enrich_case_resolution"
        ],
        "readers": [
          "defender/scripts/adapters/ticket_adapter.py::list_tickets",
          "defender/scripts/adapters/ticket_adapter.py::get_ticket",
          "defender/scripts/adapters/ticket_adapter.py::case_opened_at",
          "defender/scripts/adapters/ticket_adapter.py::health_check"
        ],
        "grep": [
          "ticket_adapter.py"
        ]
      },
      "wire_log": {
        "writers": [
          "defender/runtime/observe.py::RequestLogger"
        ],
        "readers": [
          "defender/runtime/observe.py::write_trace",
          "defender/scripts/visualize/visualize_messages.py::load_messages"
        ],
        "grep": [
          "llm_requests.jsonl",
          "logger.messages"
        ]
      },
      "learning_queue": {
        "writers": [
          "defender/learning/core/persist.py::_rewrite_queue",
          "defender/learning/core/persist.py::append_findings",
          "defender/learning/core/persist.py::_append_observations",
          "defender/learning/core/persist.py::append_pitfalls",
          "defender/learning/author/drain.py::retire",
          "defender/learning/author/drain.py::_record_stuck"
        ],
        "readers": [
          "defender/learning/author/drain.py::_tick",
          "defender/learning/core/persist.py::read_pitfalls",
          "defender/learning/core/drains.py::_pending_queue_count",
          "defender/learning/author/verify_forward/shared.py::load_observation"
        ],
        "grep": [
          "findings.jsonl",
          "_observations.jsonl",
          "pitfalls.jsonl",
          "channel.file",
          "channel.append_lock",
          "channel.drain_lock",
          "deadletter.jsonl",
          "stuck.jsonl"
        ]
      },
      "session_store": {
        "writers": [
          "defender/runtime/session_store.py::StoreHandle.new_session",
          "defender/runtime/session_store.py::StoreHandle.fork",
          "defender/runtime/session_store.py::StoreHandle.append",
          "defender/runtime/session_store.py::StoreHandle.write_config",
          "defender/runtime/session_store.py::StoreHandle.set_truncated_by",
          "defender/runtime/session_store.py::StoreHandle.set_last_render_len",
          "defender/runtime/session_store.py::open_store",
          "defender/runtime/session_store.py::write_case_pointer"
        ],
        "readers": [
          "defender/runtime/session_store.py::hydrate",
          "defender/runtime/session_store.py::synthesized_flags",
          "defender/runtime/session_store.py::path_row_ids",
          "defender/runtime/session_store.py::ends_on_complete_pair",
          "defender/runtime/session_store.py::open_store_for_read",
          "defender/runtime/session_store.py::resolve_store_path",
          "defender/runtime/selection.py::render",
          "defender/runtime/selection.py::ingest",
          "defender/runtime/selection.py::fold",
          "defender/runtime/observe.py::write_trace",
          "defender/scripts/visualize/visualize_run.py::_main_session_analysis"
        ],
        "grep": [
          "session_store",
          "sessions/",
          "session_store_pointer.json",
          "path_row_ids",
          "open_store"
        ]
      },
      "learning_run_dir": {
        "writers": [
          "defender/learning/core/persist.py::persist_run",
          "defender/learning/core/persist.py::_copy_shared_inputs",
          "defender/learning/core/persist.py::_write_source_refs",
          "defender/learning/core/run_cycle.py::_write_leg_status",
          "defender/learning/pipeline/malicious_actor/run.py::invoke_actor",
          "defender/learning/pipeline/judge/compare.py::write_comparison_files"
        ],
        "readers": [
          "defender/learning/core/directions.py::artifact_names",
          "defender/scripts/visualize/visualize_judge.py::active_views",
          "defender/learning/pipeline/judge/run.py::_cited_policy_read_body",
          "defender/learning/core/persist.py::_source_run_dir"
        ],
        "grep": [
          "learning_run_dir",
          "source_refs.yaml",
          "artifact_names",
          "paths.runs_dir"
        ]
      },
      "runs_base": {
        "writers": [
          "defender/run_common.py::materialize_run_dir"
        ],
        "readers": [
          "defender/run_common.py::resolve_runs_base",
          "defender/evals/held_out.py::index_runs",
          "defender/learning/ops/trace_lesson.py::in_context_cases"
        ],
        "grep": [
          "DEFENDER_RUNS_BASE",
          "runs_dir.iterdir",
          "runs_base"
        ]
      },
      "run_dir": {
        "writers": [
          "defender/runtime/box.py::_plant",
          "defender/runtime/observe.py::write_trace",
          "defender/runtime/driver.py::run_investigation",
          "defender/runtime/observe.py::RequestLogger",
          "defender/runtime/observe.py::denial_logger",
          "defender/runtime/session_store.py::write_case_pointer",
          "defender/hooks/budget_enforcer.py::open_budget",
          "defender/hooks/budget_enforcer.py::update_budget_locked",
          "defender/hooks/budget_enforcer.py::account_call",
          "defender/runtime/circuit_breaker.py::record_outcome",
          "defender/runtime/query_tool.py::_persist_payload",
          "defender/runtime/query_tool.py::QueryCapture._record",
          "defender/hooks/record_lead.py::claim_lead",
          "defender/_io.py::write_atomic",
          "defender/runtime/tools_gather.py::_persist_gather_summary",
          "defender/runtime/tools.py::_record_lesson_load",
          "defender/runtime/tools.py::_tool_write_file",
          "defender/runtime/tools.py::_tool_edit_file",
          "defender/scripts/case_history/ticket_writer.py::_write_receipt",
          "defender/scripts/visualize/visualize_run.py::render_and_mirror"
        ],
        "readers": [
          "defender/runtime/scrub.py::scrub",
          "defender/run_common.py::cross_check_tables",
          "defender/run_common.py::enqueue_learning",
          "defender/learning/lead_repository.py::joined",
          "defender/_run_paths.py::contained_payload"
        ],
        "grep": [
          "tool_trace.jsonl",
          "llm_requests.jsonl",
          "executed_queries.jsonl",
          "lessons_loaded.jsonl",
          "gather_raw",
          "gather_summaries",
          "budget.json",
          "circuit_breaker.json",
          "box-sentinel",
          "tool_trace.jsonl",
          "DEFENDER_RUN_DIR"
        ],
        "note": "Four writers were added after #771's phase-F reconciliation found the same hole in three instruments at once. The driver's fault-exit trace write (`write_text(\"\")` onto the fixed tool_trace.jsonl name observe.write_trace also owns) is one of the two sites that issue reported and was missing from the test census, the write lint's gate list AND this list. The queries-table append is the query tool's SECOND artifact — the payload write was censused, the table was not. The lead-claim hook and the atomic helper are the two the original grep could not see. EVERY ENTRY MUST NAME A SYMBOL THAT RESOLVES: three of the four added here did not (a leading underscore the driver's entry point does not have, an actor id where the code symbol was `_revert_strays`, and a render-lane function renamed at some point), and a resolver following a name that resolves to nothing gets the same answer as one following a row that was never written. This list seeds the next run's census, so a gap here becomes a gap in every downstream instrument. `scrub` stays under readers deliberately: #771's scan verdict is written OUTSIDE the tree it judges (§7 D8), so the walk remains a pure reader of the run dir and the marker belongs to no run-dir writer census."
      },
      "drain_worktree": {
        "writers": [
          "defender/runtime/box.py::_plant",
          "defender/learning/author/drain.py::_restore_corpus",
          "defender/learning/author/drain.py::_revert_strays",
          "defender/runtime/tools.py::_tool_write_file",
          "defender/runtime/tools.py::_tool_edit_file"
        ],
        "readers": [
          "defender/runtime/scrub.py::scrub",
          "defender/learning/author/drain.py::_snapshot_corpus",
          "defender/learning/author/branch.py::AuthorBranch"
        ],
        "grep": [
          "corpus_dir",
          "with_repo_root",
          "start_batch",
          "finish_batch",
          "changes_outside"
        ]
      }
    }
  },
  "conventions": {
    "defaultBranch": "main",
    "dangerLens": "adversarial input — alert data is attacker-influenced by definition, and malicious input is well-formed on purpose. Use this as write-tests' fourth enumeration lens unless the change's danger zone is clearly elsewhere (environment/resource, or concurrency when the design admits parallel invocation)."
  },
  "codeGraph": {
    "tool": "pyrefly",
    "configDir": "defender",
    "searchPath": [
      "..",
      "."
    ],
    "notes": "defender is a namespace package (no defender/__init__.py; pyproject at defender/, not the repo root), so pyrefly's import root defaults to defender/ and `defender.x` imports silently resolve to Unknown. searchPath is relative to configDir: `..` = repo root (makes `defender` a top-level package, mirroring pytest's pythonpath=['..']), `.` = defender/. The pyrefly-refs helper writes a temp configDir/pyrefly.toml from these and removes it per run."
  }
}
