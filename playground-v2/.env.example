# Copy to .env (gitignored) and fill in / override.

STACK_VERSION=9.3.3
CLUSTER_NAME=soc-playground

# Keycloak pin. Probe availability before bumping:
#   docker --context soc-playground manifest inspect quay.io/keycloak/keycloak:<tag>
KEYCLOAK_VERSION=26.1

# Falco pin. Probe before bumping:
#   docker --context soc-playground manifest inspect falcosecurity/falco:<tag>
FALCO_VERSION=0.39.2

# Namespaced to avoid collision with v1 vars in /workspace/.env.
# Generate with: openssl rand -base64 32 | tr -d '=+/' | cut -c1-32
V2_ELASTIC_PASSWORD=changeme
V2_KIBANA_PASSWORD=changeme

# Kibana encryption key — >= 32 chars. Used for saved-objects and reporting encryption.
# Generate with: openssl rand -base64 48 | tr -d '=+/' | cut -c1-48
V2_KIBANA_ENCRYPTION_KEY=changeme-changeme-changeme-changeme

# Keycloak bootstrap admin (master realm). Used once on first boot; after that
# manage via Keycloak UI → Users (create long-lived admin, disable this one).
V2_KEYCLOAK_ADMIN=admin
V2_KEYCLOAK_ADMIN_PASSWORD=changeme

# ES JVM heap (50% of container mem_limit, <=31g).
ES_HEAP=2g

# Baseline activity generators (batch 8). Seed is the reproducibility knob —
# same seed + same catalog → same arrival-time sequence. Change the seed to
# get a different-but-valid baseline shape.
V2_BASELINE_SEED=42
# Set to "false" to bring the stack up quiet (useful before attack-scenario
# runs so synthetic activity doesn't contaminate the capture).
V2_BASELINE_ENABLED=true

# ── Shuffle SOAR ───────────────────────────────────────────────────────────
# Pin, shared by frontend/backend/orborus/worker — bump all four together.
# Probe before bumping:
#   docker --context soc-playground manifest inspect ghcr.io/shuffle/shuffle-backend:<tag>
SHUFFLE_VERSION=2.2.1

# Shuffle's own OpenSearch heap (50% of the container's 2g mem_limit).
SHUFFLE_OPENSEARCH_HEAP=1g

# Must satisfy OpenSearch's password-strength check or the container refuses to
# boot. Generate with: openssl rand -base64 32 | tr -d '=+/' | cut -c1-32
# Read on FIRST BOOT only — it seeds the security index. Changing it later moves
# the backend and the healthcheck to the new value while OpenSearch keeps the
# old one, and the symptom is 401s, not a clear error. Rotating it means
# dropping the shuffle_opensearch_data volume (i.e. losing every workflow).
V2_SHUFFLE_OPENSEARCH_PASSWORD=changeme

# Salt for credentials Shuffle stores for its apps. Changing it orphans every
# credential already saved — set once, leave alone.
V2_SHUFFLE_ENCRYPTION_MODIFIER=changeme

# First-boot admin bootstrap: the backend creates this user, its org, and its
# default execution environment only when the user table is empty, so these are
# inert on every later restart. Username >= 3 chars; the password has to pass
# Shuffle's strength check.
V2_SHUFFLE_ADMIN_USERNAME=admin@soc-playground.local
V2_SHUFFLE_ADMIN_PASSWORD=changeme
# Used by scripts/install_soar_workflow.py. Generate with:
#   openssl rand -hex 32
V2_SHUFFLE_API_KEY=changeme
