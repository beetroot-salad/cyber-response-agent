# Applies only to builds whose `context:` is playground-v2/ (the host images —
# see hosts/Dockerfile — and the cmdb/identity stubs which need hosts/inventory.yaml
# and/or keycloak/realm.yaml). Services with scoped contexts (./keycloak, ./squid,
# ./unbound, ./zeek, ./threat-intel, ./change-mgmt) have their own context roots
# and are unaffected.
#
# Root-context builds only need hosts/, cmdb/, identity/, keycloak/realm.yaml, and (#1391)
# lab-surface.json with edge/ and endpoint-query/.
# Everything else is noise.
*
!hosts/
!hosts/**
!cmdb/
!cmdb/**
!identity/
!identity/**
!keycloak/realm.yaml
# The lab's ingress and endpoint-query service (#1391 r6) copy the one surface table.
!lab-surface.json
!edge/
!edge/**
!endpoint-query/
!endpoint-query/**
